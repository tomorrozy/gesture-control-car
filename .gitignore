# ============================================================
#  Keil MDK / STM32 工程专用 .gitignore
#  目的：把 66 MB 的工程压到 ~8 MB，只保留源码、工程文件和原理图
# ============================================================

# ---------- Keil 编译输出目录（这两项占了 58 MB，绝不能提交）----------
Obj/
OBJ/
Objects/
Listings/
DebugConfig/

# ---------- 编译中间文件 ----------
*.o
*.obj
*.d
*.crf
*.dep
*.lnp
*.lst
*.map
*.axf
*.elf
*.iex
*.tra
*.plg
*.rpt
*.bak
*.tmp
*.TMP
*.__i
*.sct
*.htm
*.win

# ---------- Keil 个人配置（含本机用户名、窗口布局、断点）----------
*.uvguix.*
*.uvguix
*.Administrator
JLinkLog.txt
JLinkSettings.ini
EventRecorderStub.scvd

# ---------- 固件产物：只保留 firmware/ 下要对外发布的 ----------
*.hex
*.bin
!firmware/*.hex
!firmware/*.bin

# ---------- 通用 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.zip
*.rar
*.7z
~$*

# ---------- 编辑器 ----------
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo

# ---------- 个人草稿 ----------
scratch/
*.local.md
